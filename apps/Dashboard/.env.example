# Discord application credentials
DISCORD_CLIENT_ID=506735111543193601
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_SECRET_PATH=C:\Users\your-name\Desktop\client_secret.txt
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
DISCORD_BOT_TOKEN=

# Fate's existing MongoDB database
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=fate

# Fate's existing XP / leaderboard database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=fate

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Comma-separated IP/CIDR allowlist for reverse proxies permitted to set X-Forwarded-For.
DASHBOARD_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Local HTTP only. HTTPS callback URLs force secure cookies even if this remains 0.
DASHBOARD_SECURE_COOKIES=0

# Local UI development only. Never enable this on a public deployment.
DASHBOARD_DEV_MODE=0
