<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/control_panel_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/control_panel_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fatecontrol" android:host="backups" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MetricsGraphWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".FateWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="xyz.fatebot.status.REFRESH" />
                <action android:name="xyz.fatebot.status.SCAN" />
                <action android:name="xyz.fatebot.status.SCHEDULED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fate_widget_info" />
        </receiver>

        <receiver
            android:name=".FateMemoryWidgetProvider"
            android:exported="true"
            android:label="@string/memory_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="xyz.fatebot.status.REFRESH_MEMORY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fate_memory_widget_info" />
        </receiver>

        <receiver
            android:name=".FateConsoleWidgetProvider"
            android:exported="true"
            android:label="@string/console_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="xyz.fatebot.status.REFRESH_CONSOLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fate_console_widget_info" />
        </receiver>

        <receiver
            android:name=".FateControlWidgetProvider"
            android:exported="true"
            android:label="@string/control_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fate_control_widget_info" />
        </receiver>

        <receiver
            android:name=".MetricsGraphWidgetProvider"
            android:exported="true"
            android:label="@string/metrics_graph_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="xyz.fatebot.status.REFRESH_METRICS_GRAPH" />
                <action android:name="xyz.fatebot.status.SCHEDULED_METRICS_GRAPH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fate_metrics_graph_widget_info" />
        </receiver>

        <receiver
            android:name=".FateControlActionReceiver"
            android:exported="false" />
    </application>

</manifest>
