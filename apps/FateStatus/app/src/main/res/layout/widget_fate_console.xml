<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/console_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/console_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/console_widget_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/console_widget_header"
                android:textColor="@color/fate_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/console_widget_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/console_widget_syncing"
                android:textColor="@color/fate_gold"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/console_widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/widget_refresh_symbol"
            android:textColor="@color/fate_text"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/console_widget_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#B3110D11"
        android:ellipsize="start"
        android:fontFamily="monospace"
        android:gravity="bottom|start"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="12"
        android:padding="10dp"
        android:text="@string/console_widget_loading"
        android:textColor="@color/fate_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/console_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="@string/widget_no_data"
        android:textColor="@color/fate_muted"
        android:textSize="11sp" />
</LinearLayout>
