        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7C3AED" android:endColor="#0891B2" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8B5CF6" android:endColor="#06B6D4" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
